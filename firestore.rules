rules_version = '2';

// Each signed-in user (including anonymous users) may read and write only their
// own document. Nothing else in the database is reachable from the client.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
